<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Central Glowing Play Triangle (Subtle behind letters) -->
    <path
        android:pathData="M48,34 L66,45 L48,56 Z"
        android:fillColor="#352652" />

    <!-- Play button neon rim -->
    <path
        android:pathData="M48,34 L66,45 L48,56 Z"
        android:strokeWidth="1.2"
        android:strokeColor="#7C4DFF"
        android:fillColor="#00000000" />

    <!-- Circular aperture / camera lens ring -->
    <path
        android:pathData="M54,26 A22,22 0 1,1 53.9,26 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#4A5568"
        android:fillColor="#00000000" />

    <!-- 'X' metallic letter: 26 to 43 on X axis, 36 to 62 on Y axis -->
    <!-- X Stroke 1: Top-Left to Bottom-Right -->
    <path
        android:pathData="M27,37 L33,37 L45,61 L39,61 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="27"
                android:startY="37"
                android:endX="45"
                android:endY="61"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.4" android:color="#C5D0E6" />
                <item android:offset="0.8" android:color="#7F92B3" />
                <item android:offset="1.0" android:color="#516383" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- X Stroke 2: Top-Right to Bottom-Left -->
    <path
        android:pathData="M45,37 L39,37 L27,61 L33,61 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="45"
                android:startY="37"
                android:endX="27"
                android:endY="61"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.3" android:color="#E0E7FF" />
                <item android:offset="0.7" android:color="#8DA2FB" />
                <item android:offset="1.0" android:color="#4338CA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 'M' metallic letter: 44 to 64 on X axis, 37 to 61 on Y axis -->
    <path
        android:pathData="M45,61 L45,37 L51,37 L54,48 L57,37 L63,37 L63,61 L58,61 L58,45 L55.5,53 L52.5,53 L50,45 L50,61 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="45"
                android:startY="37"
                android:endX="63"
                android:endY="61"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.35" android:color="#F1F5F9" />
                <item android:offset="0.7" android:color="#94A3B8" />
                <item android:offset="1.0" android:color="#475569" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 'L' metallic letter: 65 to 81 on X axis, 37 to 61 on Y axis -->
    <path
        android:pathData="M65,37 L71,37 L71,55 L81,55 L81,61 L65,61 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="65"
                android:startY="37"
                android:endX="81"
                android:endY="61"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFD166" />
                <item android:offset="0.4" android:color="#FF9F1C" />
                <item android:offset="0.8" android:color="#F77F00" />
                <item android:offset="1.0" android:color="#D62828" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Filmstrip & Timeline Elements at the Bottom (Safe Zone 70 to 86) -->
    <!-- Timeline Container Bar -->
    <path
        android:pathData="M24,70 L84,70 A3,3 0 0,1 87,73 L87,83 A3,3 0 0,1 84,86 L24,86 A3,3 0 0,1 21,73 L21,73 A3,3 0 0,1 24,70 Z"
        android:fillColor="#11131F"
        android:strokeWidth="1"
        android:strokeColor="#2E344E" />

    <!-- Filmstrip sprocket holes (top row of timeline) -->
    <path
        android:pathData="M25,72 L27,72 L27,74 L25,74 Z M30,72 L32,72 L32,74 L30,74 Z M35,72 L37,72 L37,74 L35,74 Z M40,72 L42,72 L42,74 L40,74 Z M45,72 L47,72 L47,74 L45,74 Z M61,72 L63,72 L63,74 L61,74 Z M66,72 L68,72 L68,74 L66,74 Z M71,72 L73,72 L73,74 L71,74 Z M76,72 L78,72 L78,74 L76,74 Z M81,72 L83,72 L83,74 L81,74 Z"
        android:fillColor="#475569" />

    <!-- Glowing Playhead Needle in center of timeline -->
    <path
        android:pathData="M54,67 L56,69 L56,86 L52,86 L52,69 Z"
        android:fillColor="#C084FC" />
    <path
        android:pathData="M54,66 L55,67 L53,67 Z"
        android:fillColor="#FFFFFF" />

    <!-- Mini cut scissors icon on left of timeline (26, 76) -->
    <path
        android:pathData="M26,76 L31,81 M26,81 L31,76 M25.5,75 A1,1 0 1,0 25.5,77 A1,1 0 1,0 25.5,75 M25.5,80 A1,1 0 1,0 25.5,82 A1,1 0 1,0 25.5,80"
        android:strokeWidth="1"
        android:strokeColor="#A855F7"
        android:fillColor="#00000000" />

    <!-- Mini waveform bars (36 to 48) -->
    <path
        android:pathData="M36,81 L36,77 M39,82 L39,76 M42,83 L42,75 M45,82 L45,77 M48,80 L48,78"
        android:strokeWidth="1.2"
        android:strokeColor="#38BDF8" />

    <!-- Mini play icon on right of timeline (76, 77) -->
    <path
        android:pathData="M76,76 L81,79 L76,82 Z"
        android:fillColor="#F59E0B" />

</vector>
